APP_ORIGIN=http://localhost:3000
# Vieša registracija per patvirtintą Google arba Microsoft OIDC tapatybę.
# Nustačius false, esami naudotojai prisijungia, bet naujos paskyros nekuriamos.
PUBLIC_SIGNUP=true
# Nustatyk prieš pirmą viešą paleidimą. Šio adreso pirmas prisijungimas tampa administratoriumi.
INITIAL_ADMIN_EMAIL=
# Sugeneruok: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=PAKEISK_64_SIMBOLIU_HEX_REIKSME
# Sugeneruok vieną kartą ir nekeisk tarp konteinerio atnaujinimų:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Tame pačiame Google OAuth kliente taip pat registruok:
# http://localhost:3000/api/auth/google-oidc/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/callback
# Toje pačioje Entra aplikacijoje taip pat registruok:
# http://localhost:3000/api/auth/microsoft-oidc/callback
# Santykinis kelias veikia tiek vietoje, tiek Docker /app kataloge.
DATABASE_PATH=./data/planner.db
